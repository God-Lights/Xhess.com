// ---- pawn structure ----
SCORE(doubledPawn, -21, -18)
SCORE(isolatedPawn, -8, -9)
ARRAY(supportedPawnMg, 8, 0, 0, 4, 2, 15, 60, 83, 0)   // by relative rank; the endgame value is half of it
ARRAY(phalanxPawnMg, 8, 0, 0, 2, 8, 16, 53, 1038, 0)
ARRAY(passedMg, 8, 0, -35, -38, -30, -27, 32, 111, 0)
ARRAY(passedEg, 8, 0, 40, 42, 66, 82, 126, 193, 0)

// ---- pieces ----
SCORE(bishopPair, 32, 52)
SCORE(knightOutpost, 46, 44)
SCORE(rookOpenFile, 41, 1)
SCORE(rookSemiOpenFile, 22, 19)
SCORE(rookOnSeventh, 53, 15)
ARRAY(mobilityBase, 7, 0, 0, 4, 6, 6, 12, 0)    // safe squares at which the bonus is zero
ARRAY(mobilityMg, 7, 0, 0, 4, 5, 6, 2, 0)       // bonus per safe square above the base
ARRAY(mobilityEg, 7, 0, 0, 1, 3, 3, 0, 0)

// ---- king safety ----
ARRAY(kingAttackUnit, 7, 0, 0, 2, 2, 3, 5, 0)   // not tuned: it enters the score quadratically
INT(shieldNear, 5)       // own pawn directly in front of the king's files
INT(shieldFar, -5)         // own pawn two ranks in front
INT(shieldMissing, -7)
INT(kingFileOpen, -38)    // no pawns at all on a file next to the king
INT(kingFileSemiOpen, -8) // only enemy pawns on it

// ---- endgame knowledge ----
INT(unstoppablePasser, 450)
INT(mopUpEdge, 10)        // per step the lone enemy king is away from the center
INT(mopUpKing, 8)         // per step our king is closer to it
