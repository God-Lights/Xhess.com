{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xhess",
  "version": "0.5.0",
  "identifier": "com.xhess.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xhess",
        "width": 1100,
        "height": 800,
        "minWidth": 700,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/xhess-stockfish"
    ],
    "resources": {
      "binaries/STOCKFISH-COPYING.txt": "licenses/STOCKFISH-COPYING.txt"
    }
  }
}
